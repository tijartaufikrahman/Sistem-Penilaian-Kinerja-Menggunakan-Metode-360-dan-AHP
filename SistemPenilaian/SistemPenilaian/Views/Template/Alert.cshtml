@{
    ViewData["Title"] = "Template Alert & Badge";
}

<!-- ATURAN 1: Tag pembungkus paling awal di file konten wajib diawali <div class="row ..."> -->
<div class="row">
    <div class="col-12 mb-3">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-bell" style="color:#0f766e;margin-right:.45rem;"></i>Template Alert & Status Badge</h3>
            </div>
            <div class="card-body">
                <p class="text-muted" style="font-size:.85rem;margin-bottom:1.5rem;">
                    Kumpulan template notifikasi banner, alert interaktif, serta badge status warna-warni.
                </p>

                <h5 style="font-size:.92rem;font-weight:700;margin-bottom:12px;color:#0f172a;">Variasi Alert Banner</h5>
                <div class="alert alert-success d-flex align-items-center gap-2 py-2 mb-2" role="alert" style="font-size:.85rem;">
                    <i class="fas fa-check-circle"></i>
                    <div><strong>Berhasil!</strong> Data Anda telah tersimpan dengan aman ke dalam sistem.</div>
                </div>

                <div class="alert alert-info d-flex align-items-center gap-2 py-2 mb-2" role="alert" style="font-size:.85rem;">
                    <i class="fas fa-info-circle"></i>
                    <div><strong>Informasi:</strong> Sesi pengguna Anda akan berakhir dalam 24 jam ke depan.</div>
                </div>

                <div class="alert alert-warning d-flex align-items-center gap-2 py-2 mb-2" role="alert" style="font-size:.85rem;">
                    <i class="fas fa-exclamation-triangle"></i>
                    <div><strong>Peringatan:</strong> Mohon periksa kembali kelengkapan formulir sebelum dikirim.</div>
                </div>

                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3" role="alert" style="font-size:.85rem;">
                    <i class="fas fa-times-circle"></i>
                    <div><strong>Kesalahan!</strong> Terjadi kendala saat memproses tindakan Anda.</div>
                </div>

                <hr style="margin:1.5rem 0;border-color:#e2e8f0;" />

                <h5 style="font-size:.92rem;font-weight:700;margin-bottom:12px;color:#0f172a;">Variasi Badge Status</h5>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge bg-primary">Primary</span>
                    <span class="badge bg-secondary">Secondary</span>
                    <span class="badge bg-success">Success / Aktif</span>
                    <span class="badge bg-danger">Danger / Ditolak</span>
                    <span class="badge bg-warning text-dark">Warning / Pending</span>
                    <span class="badge bg-info text-dark">Info / Proses</span>
                    <span class="badge bg-dark">Dark</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <!-- ATURAN 2: Onclick di tag HTML memanggil fungsi JS -->
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="tampilkanToastNotif('success')">
                        <i class="fas fa-check"></i> Trigger Notifikasi Sukses
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="tampilkanToastNotif('danger')">
                        <i class="fas fa-exclamation"></i> Trigger Notifikasi Gagal
                    </button>
                </div>

                <div id="toastArea" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ATURAN 2: Handler fungsi dipanggil via onclick pada tag HTML
        function tampilkanToastNotif(jenis) {
            if (jenis === 'success') {
                $('#toastArea').html('<div class="alert alert-success alert-dismissible fade show py-2" role="alert" style="font-size:.85rem;"><i class="fas fa-check-circle"></i> Aksi notifikasi sukses dipicu via jQuery! <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>');
            } else {
                $('#toastArea').html('<div class="alert alert-danger alert-dismissible fade show py-2" role="alert" style="font-size:.85rem;"><i class="fas fa-exclamation-circle"></i> Aksi notifikasi error dipicu via jQuery! <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>');
            }
        }
    </script>
}
