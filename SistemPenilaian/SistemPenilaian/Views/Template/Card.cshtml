@{
    ViewData["Title"] = "Template Card";
}

<!-- ATURAN 1: Tag pembungkus paling awal di file konten wajib diawali <div class="row ..."> -->
<div class="row">
    <div class="col-12 mb-3">
        <h4 style="font-size:1.15rem;font-weight:700;color:#0f172a;margin-bottom:4px;">
            <i class="fas fa-id-card" style="color:#0f766e;margin-right:.45rem;"></i>Template Card & Widget
        </h4>
        <p class="text-muted" style="font-size:.85rem;margin-bottom:1.5rem;">
            Ragam variasi kartu informasi, statistik, dan panel data dengan desain selaras tema aplikasi.
        </p>
    </div>
</div>

<div class="row">
    <!-- Stat Card 1 -->
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="stat-card">
            <div class="stat-icon green"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="stat-number">128</div>
                <div class="stat-label">Tugas Selesai</div>
            </div>
        </div>
    </div>
    <!-- Stat Card 2 -->
    <div class="col-md-4 col-sm-6 mb-3">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fas fa-clock"></i></div>
            <div>
                <div class="stat-number">24</div>
                <div class="stat-label">Sedang Berjalan</div>
            </div>
        </div>
    </div>
    <!-- Stat Card 3 -->
    <div class="col-md-4 col-sm-12 mb-3">
        <div class="stat-card">
            <div class="stat-icon orange"><i class="fas fa-exclamation-circle"></i></div>
            <div>
                <div class="stat-number">7</div>
                <div class="stat-label">Perlu Ditinjau</div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Card Utama -->
    <div class="col-lg-6 col-md-12 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h3><i class="fas fa-layer-group" style="color:#0f766e;margin-right:.45rem;"></i>Kartu Konten Standar</h3>
            </div>
            <div class="card-body">
                <p style="font-size:.88rem;color:#475569;">
                    Komponen kartu standar menggunakan border melengkung modern, shadow halus, dan header bergaris tipis untuk menampilkan informasi yang terstruktur.
                </p>
                <!-- ATURAN 2: Onclick di tag HTML memanggil fungsi JS -->
                <button type="button" class="btn btn-sm btn-primary" style="background:#0d9488;border-color:#0d9488;" onclick="tambahAngkaWidget()">
                    <i class="fas fa-plus"></i> Tambah Angka Interaktif
                </button>
            </div>
        </div>
    </div>

    <!-- Card Interaktif -->
    <div class="col-lg-6 col-md-12 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h3><i class="fas fa-chart-line" style="color:#0f766e;margin-right:.45rem;"></i>Kartu Counter Interaktif</h3>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                <div id="counterNilai" style="font-size:2.8rem;font-weight:700;color:#0f766e;line-height:1;">10</div>
                <div class="text-muted" style="font-size:.82rem;margin-top:4px;">Nilai dihitung via jQuery</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ATURAN 2: Handler fungsi dipanggil via onclick pada tag HTML
        function tambahAngkaWidget() {
            var val = parseInt($('#counterNilai').text(), 10) || 0;
            $('#counterNilai').text(val + 1);
        }
    </script>
}
