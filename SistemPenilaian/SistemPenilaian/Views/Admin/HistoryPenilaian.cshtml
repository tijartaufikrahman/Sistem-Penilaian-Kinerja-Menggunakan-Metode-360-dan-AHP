@{
    ViewData["Title"] = "Riwayat & Tren Kinerja Karyawan";
}

<!-- Outermost View Wrapper adhering to aturan_styling.txt -->
<div class="row">
    <div class="col-12">

        <!-- Breadcrumb Bar (Identik Project 7) -->
        <div class="content-breadcrumb-bar mb-2">
            <div class="breadcrumb-nav" id="pageBreadcrumb">
                <span class="breadcrumb-parent">Sistem Informasi</span>
                <span class="breadcrumb-separator">/</span>
                <span class="breadcrumb-current">Riwayat &amp; Tren Kinerja Karyawan</span>
            </div>
        </div>

        <!-- Stat Highlights (Identik Project 7) -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-sm-6">
                <div class="stat-card-box">
                    <div class="stat-header">
                        <span class="stat-label-text">Total Laporan Penilaian</span>
                        <div class="stat-icon-wrapper stat-icon-teal">
                            <i class="fas fa-folder-open"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-number-value" id="statTotalArsip">0</div>
                        <div class="stat-subtext">
                            <span class="status-pill pill-active" style="padding:1px 6px; font-size:10px;">Semua Periode</span>
                            <span>Data evaluasi tersimpan</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-sm-6">
                <div class="stat-card-box">
                    <div class="stat-header">
                        <span class="stat-label-text">Rata-rata Nilai Kinerja</span>
                        <div class="stat-icon-wrapper stat-icon-blue">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-number-value" style="color:#0d9488;" id="statRataSkorGlobal">0.00</div>
                        <div class="stat-subtext">
                            <span class="status-pill pill-role" style="padding:1px 6px; font-size:10px;">Seluruh Karyawan</span>
                            <span>Nilai rata-rata</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-sm-6">
                <div class="stat-card-box">
                    <div class="stat-header">
                        <span class="stat-label-text">Rekomendasi Prioritas</span>
                        <div class="stat-icon-wrapper stat-icon-green">
                            <i class="fas fa-file-contract"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-number-value" style="color:#16a34a;" id="statTotalPrioritas">0</div>
                        <div class="stat-subtext">
                            <span class="status-pill pill-active" style="padding:1px 6px; font-size:10px;"><span class="dot-indicator"></span>Kinerja Baik</span>
                            <span>Memenuhi Standar</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 col-sm-6">
                <div class="stat-card-box">
                    <div class="stat-header">
                        <span class="stat-label-text">Perlu Pembinaan</span>
                        <div class="stat-icon-wrapper stat-icon-orange">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-number-value" style="color:#dc2626;" id="statTotalEvaluasi">0</div>
                        <div class="stat-subtext">
                            <span class="status-pill pill-inactive" style="padding:1px 6px; font-size:10px;"><span class="dot-indicator"></span>Perlu Evaluasi</span>
                            <span>Tindak Lanjut HRD</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Admin Card: Filter & Data History Table -->
        <div class="admin-card mb-4">
            <div class="admin-card-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                <div>
                    <h3 class="admin-card-title">Riwayat Evaluasi &amp; Tren Capaian Kinerja</h3>
                    <p class="admin-card-desc">Menampilkan rekapitulasi data capaian kinerja karyawan lintas periode evaluasi</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn-secondary-admin btn-sm" onclick="muatDataHistoryGlobal()">
                        <i class="fas fa-sync-alt me-1"></i> Muat Ulang
                    </button>
                    <button type="button" class="btn-primary-admin btn-sm" onclick="window.print()">
                        <i class="fas fa-print me-1"></i> Cetak Laporan
                    </button>
                </div>
            </div>

            <!-- Filter Controls Box (Identik Project 7) -->
            <div class="p-3 mx-3 mx-md-4 mt-3 rounded-3 border" style="background:#f8fafc;">
                <div class="row align-items-center g-3">
                    <div class="col-md-5">
                        <label class="form-field-label mb-1">Periode Penilaian:</label>
                        <select class="form-field-input" id="selectFilterPeriodeHistory" onchange="filterDataHistoryTabel()">
                            <option value="">Semua Periode</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-field-label mb-1">Kategori Capaian:</label>
                        <select class="form-field-input" id="selectFilterKategoriHistory" onchange="filterDataHistoryTabel()">
                            <option value="">Semua Kategori</option>
                        </select>
                    </div>
                    <div class="col-md-2 text-md-end pt-md-3">
                        <button type="button" class="btn-secondary-admin w-100 justify-content-center" onclick="resetFilterHistory()">
                            <i class="fas fa-undo me-1"></i> Reset
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle w-100" id="tabelHistoryGlobal" style="font-size:12px;">
                    <thead class="table-light text-nowrap">
                        <tr>
                            <th class="text-center" style="width:70px;">PERIODE</th>
                            <th class="text-center" style="width:60px;">PERINGKAT</th>
                            <th>ID KARYAWAN</th>
                            <th>NAMA KARYAWAN</th>
                            <th class="text-center">RATA-RATA EVALUASI</th>
                            <th class="text-center fw-bold text-teal" style="font-size:13px;">NILAI AKHIR</th>
                            <th class="text-center">KATEGORI CAPAIAN</th>
                            <th>REKOMENDASI TINDAK LANJUT</th>
                            <th style="text-align:right; width:90px;">AKSI</th>
                        </tr>
                    </thead>
                    <tbody id="tabelHistoryGlobalBody"></tbody>
                </table>
            </div>
        </div>

    </div> <!-- Close outer col-12 -->
</div> <!-- Close outer row -->

<!-- Modal Detail Tren Karyawan (Identik Project 7 AdminModal) -->
<div class="admin-modal-backdrop" id="modalTrenKaryawan">
    <div class="admin-modal-card" style="max-width: 700px;">
        <div class="admin-modal-head">
            <h4 class="admin-modal-title">Rekam Jejak &amp; Tren Kinerja Karyawan</h4>
            <button type="button" class="btn-modal-close" onclick="AdminModal.close('modalTrenKaryawan')">&times;</button>
        </div>
        <div class="admin-modal-content">
            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-3 border" style="background:#f8fafc;">
                <div>
                    <h5 class="mb-0 fw-bold text-dark" id="trenNamaKaryawan">-</h5>
                    <span class="text-muted" style="font-size:12px;" id="trenKodeKaryawan">-</span>
                </div>
                <div class="text-end">
                    <span class="text-muted d-block" style="font-size:11px; text-transform:uppercase; font-weight:700;">Rata-rata Nilai:</span>
                    <h3 class="mb-0 fw-bold text-teal font-monospace" id="trenAvgSkorKumulatif">0.00</h3>
                </div>
            </div>

            <h6 class="fw-bold text-dark mb-2" style="font-size:13px;">Riwayat Evaluasi per Periode:</h6>
            <div class="table-responsive border rounded-3 mb-3">
                <table class="table table-bordered table-sm align-middle mb-0" style="font-size:11.5px;">
                    <thead class="table-light">
                        <tr>
                            <th>Periode</th>
                            <th class="text-center">Peringkat</th>
                            <th class="text-center">Nilai Akhir</th>
                            <th class="text-center">Kategori</th>
                            <th>Rekomendasi Tindak Lanjut</th>
                            <th>Catatan Pembinaan</th>
                        </tr>
                    </thead>
                    <tbody id="tabelTrenListBody"></tbody>
                </table>
            </div>

            <div class="p-3 rounded-3" style="background:#f0fdfa; border:1px solid #99f6e4; font-size:12px; color:#0f766e;">
                <strong class="d-block mb-1"><i class="fas fa-chart-line me-1"></i> Catatan Ringkasan Evaluasi:</strong>
                <p class="mb-0" id="trenSummaryText">Karyawan menunjukkan performa yang konsisten sepanjang periode penilaian.</p>
            </div>
        </div>
        <div class="admin-modal-foot">
            <button type="button" class="btn-secondary-admin" onclick="AdminModal.close('modalTrenKaryawan')">Tutup</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var dtHistoryInstance = null;
    var rawGlobalHistoryList = [];
    var periodeOptionsList = [];

    function muatPeriodeDropdown() {
        $.ajax({
            url: API_BASE_URL + '/periode',
            type: 'GET',
            dataType: 'json',
            success: function (list) {
                periodeOptionsList = list || [];
                var html = '<option value="">Semua Periode</option>';
                for (var i = 0; i < periodeOptionsList.length; i++) {
                    var p = periodeOptionsList[i];
                    html += '<option value="' + p.id + '">' + p.namaPeriode + '</option>';
                }
                $('#selectFilterPeriodeHistory').html(html);
            }
        });
    }

    function muatDataHistoryGlobal() {
        $.ajax({
            url: API_BASE_URL + '/hasilpenilaiansistem/history-global',
            type: 'GET',
            dataType: 'json',
            beforeSend: function () {
                $('#tabelHistoryGlobalBody').html('<tr><td colspan="9" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-1"></i> Memuat riwayat evaluasi...</td></tr>');
            },
            success: function (data) {
                rawGlobalHistoryList = data || [];
                muatKategoriFilterDropdown(rawGlobalHistoryList);
                hitungStatistikHighlights(rawGlobalHistoryList);
                renderTabelHistory(rawGlobalHistoryList);
            },
            error: function () {
                $('#tabelHistoryGlobalBody').html('<tr><td colspan="9" class="text-center py-4 text-danger">Gagal memuat riwayat evaluasi.</td></tr>');
            }
        });
    }

    function muatKategoriFilterDropdown(list) {
        var katSet = [];
        for (var i = 0; i < list.length; i++) {
            if (list[i].namaKategori && katSet.indexOf(list[i].namaKategori.trim()) === -1) {
                katSet.push(list[i].namaKategori.trim());
            }
        }
        var html = '<option value="">Semua Kategori</option>';
        for (var k = 0; k < katSet.length; k++) {
            html += '<option value="' + escHtml(katSet[k]) + '">' + escHtml(katSet[k]) + '</option>';
        }
        $('#selectFilterKategoriHistory').html(html);
    }

    function hitungStatistikHighlights(list) {
        var total = list.length;
        var sumSkor = 0;
        var prioritas = 0;
        var evaluasi = 0;

        for (var i = 0; i < total; i++) {
            var item = list[i];
            sumSkor += item.skorAkhirAHP;
            var kat = (item.namaKategori || '').toLowerCase();
            var rek = (item.rekomendasi || '').toLowerCase();
            if (rek.indexOf('tidak') === -1 && (rek.indexOf('perpanjang') !== -1 || rek.indexOf('prioritas') !== -1 || kat.indexOf('baik') !== -1 || kat.indexOf('istimewa') !== -1)) {
                prioritas++;
            } else {
                evaluasi++;
            }
        }

        var avgSkor = total > 0 ? (sumSkor / total).toFixed(2) : '0.00';

        $('#statTotalArsip').text(total);
        $('#statRataSkorGlobal').text(avgSkor);
        $('#statTotalPrioritas').text(prioritas);
        $('#statTotalEvaluasi').text(evaluasi);
    }

    function renderTabelHistory(list) {
        if (dtHistoryInstance) {
            dtHistoryInstance.destroy();
        }

        var html = '';
        if (list.length > 0) {
            for (var i = 0; i < list.length; i++) {
                var h = list[i];
                var statusClass = 'pill-role';
                var katLow = (h.namaKategori || '').toLowerCase();
                if (katLow.indexOf('sangat baik') !== -1 || katLow.indexOf('istimewa') !== -1) statusClass = 'pill-active';
                else if (katLow.indexOf('baik') !== -1) statusClass = 'pill-active';
                else if (katLow.indexOf('cukup') !== -1) statusClass = 'pill-role';
                else if (katLow.indexOf('kurang') !== -1 || katLow.indexOf('buruk') !== -1) statusClass = 'pill-inactive';

                var avg360 = 0;
                if (h.kriteriaNilai && h.kriteriaNilai.length > 0) {
                    var sumKn = 0;
                    for (var k = 0; k < h.kriteriaNilai.length; k++) {
                        sumKn += h.kriteriaNilai[k].nilaiRataRata;
                    }
                    avg360 = (sumKn / h.kriteriaNilai.length).toFixed(2);
                } else {
                    avg360 = ((h.rata2_KerjasamaTim + h.rata2_KetepatanWaktu + h.rata2_TanggungJawab + 
                                   h.rata2_Inisiatif + h.rata2_KeterlibatanKerja + h.rata2_InteraksiKolega + 
                                   h.rata2_TindakLanjut) / 7.0).toFixed(2);
                }

                var rankBadge = '<span class="status-pill ' + (h.ranking === 1 ? 'pill-active' : 'pill-role') + '" style="font-size:11px;">#' + h.ranking + '</span>';

                html += '<tr>' +
                    '<td class="text-center"><span class="code-tag">' + escHtml(h.namaPeriode || ('P-' + h.periodeId)) + '</span></td>' +
                    '<td class="text-center">' + rankBadge + '</td>' +
                    '<td><span class="code-tag">' + escHtml(h.kodeKaryawan) + '</span></td>' +
                    '<td><strong style="color:#0f172a;">' + escHtml(h.namaKaryawan) + '</strong></td>' +
                    '<td class="text-center font-monospace">' + avg360 + '</td>' +
                    '<td class="text-center font-monospace fw-bold text-teal" style="font-size:13.5px;">' + h.skorAkhirAHP.toFixed(2) + '</td>' +
                    '<td class="text-center"><span class="status-pill ' + statusClass + '">' + escHtml(h.namaKategori) + '</span></td>' +
                    '<td><span style="font-size:12px; color:#334155; font-weight:600;">' + escHtml(h.rekomendasi) + '</span></td>' +
                    '<td class="text-end">' +
                        '<button type="button" class="btn btn-sm btn-light border" style="font-size:11px;" onclick="bukaModalTren(' + h.userId + ', \'' + escHtml(h.namaKaryawan).replace(/'/g, "\\'") + '\', \'' + escHtml(h.kodeKaryawan) + '\')">' +
                            '<i class="fas fa-chart-line text-teal me-1"></i> Lihat Tren' +
                        '</button>' +
                    '</td>' +
                    '</tr>';
            }
        }

        $('#tabelHistoryGlobalBody').html(html);

        dtHistoryInstance = $('#tabelHistoryGlobal').DataTable({
            pageLength: 10,
            lengthMenu: window.dtLengthMenuConfig,
            language: window.dtLanguageConfig,
            order: [[0, 'desc'], [1, 'asc']]
        });
    }

    function filterDataHistoryTabel() {
        var selectedPeriodeId = parseInt($('#selectFilterPeriodeHistory').val());
        var selectedKategori = $('#selectFilterKategoriHistory').val();

        var filtered = rawGlobalHistoryList.filter(function (item) {
            var matchPeriode = !selectedPeriodeId || item.periodeId === selectedPeriodeId;
            var matchKategori = !selectedKategori || (item.namaKategori && item.namaKategori.trim().toLowerCase() === selectedKategori.trim().toLowerCase());
            return matchPeriode && matchKategori;
        });

        renderTabelHistory(filtered);
    }

    function resetFilterHistory() {
        $('#selectFilterPeriodeHistory').val('');
        $('#selectFilterKategoriHistory').val('');
        renderTabelHistory(rawGlobalHistoryList);
    }

    function bukaModalTren(userId, namaKaryawan, kodeKaryawan) {
        $('#trenNamaKaryawan').text(namaKaryawan);
        $('#trenKodeKaryawan').text('ID: ' + kodeKaryawan);

        $.ajax({
            url: API_BASE_URL + '/hasilpenilaiansistem/user/' + userId,
            type: 'GET',
            dataType: 'json',
            beforeSend: function () {
                $('#tabelTrenListBody').html('<tr><td colspan="6" class="text-center py-3 text-muted"><i class="fas fa-spinner fa-spin me-1"></i> Memuat rekam jejak...</td></tr>');
            },
            success: function (data) {
                var list = data || [];
                var html = '';
                var totalSkor = 0;

                if (list.length > 0) {
                    for (var i = 0; i < list.length; i++) {
                        var item = list[i];
                        totalSkor += item.skorAkhirAHP;

                        var statusClass = 'pill-role';
                        var katLow = (item.namaKategori || '').toLowerCase();
                        if (katLow.indexOf('baik') !== -1) statusClass = 'pill-active';
                        if (katLow.indexOf('kurang') !== -1) statusClass = 'pill-inactive';

                        html += '<tr>' +
                            '<td><strong>' + escHtml(item.namaPeriode || ('Periode ' + item.periodeId)) + '</strong></td>' +
                            '<td class="text-center"><span class="status-pill pill-role">#' + item.ranking + '</span></td>' +
                            '<td class="text-center font-monospace fw-bold text-teal">' + item.skorAkhirAHP.toFixed(2) + '</td>' +
                            '<td class="text-center"><span class="status-pill ' + statusClass + '">' + escHtml(item.namaKategori) + '</span></td>' +
                            '<td>' + escHtml(item.rekomendasi) + '</td>' +
                            '<td><small class="text-muted">' + escHtml(item.catatanHRD || '-') + '</small></td>' +
                            '</tr>';
                    }
                    var avg = (totalSkor / list.length).toFixed(2);
                    $('#trenAvgSkorKumulatif').text(avg);

                    var summaryMsg = 'Karyawan memiliki capaian nilai rata-rata ' + avg + ' dari ' + list.length + ' periode evaluasi tercatat.';
                    if (avg >= 80) {
                        summaryMsg += ' Capaian kinerja tergolong SANGAT BAIK dan konsisten memenuhi standar kinerja.';
                    } else if (avg >= 60) {
                        summaryMsg += ' Capaian kinerja tergolong CUKUP dengan ruang peningkatan pada aspek kompetensi terkait.';
                    } else {
                        summaryMsg += ' Capaian kinerja tergolong KURANG dan memerlukan pendampingan serta evaluasi tindak lanjut.';
                    }
                    $('#trenSummaryText').text(summaryMsg);
                } else {
                    html = '<tr><td colspan="6" class="text-center py-3 text-muted">Belum ada riwayat evaluasi periode yang tersimpan untuk karyawan ini.</td></tr>';
                    $('#trenAvgSkorKumulatif').text('0.00');
                    $('#trenSummaryText').text('Belum ada data evaluasi kinerja resmi yang disahkan.');
                }

                $('#tabelTrenListBody').html(html);
                AdminModal.open('modalTrenKaryawan');
            },
            error: function () {
                $('#tabelTrenListBody').html('<tr><td colspan="6" class="text-center py-3 text-danger">Gagal memuat rekam jejak.</td></tr>');
            }
        });
    }

    $(function () {
        muatPeriodeDropdown();
        muatDataHistoryGlobal();
    });
</script>
}
