@{
    ViewData["Title"] = "Atur Ulang Kata Sandi";
    Layout = null;
    var loginUrl = "/Account/Login";
    var token = (ViewData["Token"] as string) ?? "";
    var otp = (ViewData["Otp"] as string) ?? token;
    var email = (ViewData["Email"] as string) ?? "";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Atur Ulang Kata Sandi - Sistem Informasi Penilaian Kinerja</title>
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%; max-width: 100vw; overflow-x: hidden;
            font-family: 'Plus Jakarta Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #eef7f5;
            background-image: radial-gradient(circle at 20% 30%, rgba(45,212,191,.15) 0%, transparent 50%),
                              radial-gradient(circle at 80% 70%, rgba(56,189,248,.12) 0%, transparent 50%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 10px 40px rgba(15,23,42,.08);
            padding: 44px 36px 36px;
            border: 1px solid rgba(15,23,42,.06);
        }
        @@media (max-width:480px) {
            .card { padding: 32px 20px 28px; border-radius: 16px; }
        }
        .header { text-align: center; margin-bottom: 26px; }
        .logo {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #2dd4bf, #0d9488);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            box-shadow: 0 8px 24px rgba(13,148,136,.25);
            transition: transform .3s ease;
        }
        .logo:hover { transform: scale(1.05); }
        .logo i { font-size: 28px; color: #ffffff; }
        .header h1 { font-size: 20px; color: #0f172a; font-weight: 700; margin-bottom: 6px; }
        .header p { color: #64748b; font-size: 13px; line-height: 1.6; }
        .info-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 12px;
            padding: 13px 15px;
            font-size: 12.5px;
            color: #166534;
            line-height: 1.6;
            margin-bottom: 20px;
        }
        .info-box i { color: #16a34a; margin-right: 6px; }
        .form-group { margin-bottom: 18px; }
        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 7px;
        }
        .input-wrapper { position: relative; }
        .input-wrapper i.fi {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 15px;
        }
        .toggle-pwd {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            cursor: pointer;
            font-size: 15px;
            background: none;
            border: none;
            padding: 4px;
            transition: color .2s;
        }
        .toggle-pwd:hover { color: #0d9488; }
        .form-group input {
            width: 100%;
            padding: 12px 42px 12px 42px;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            font-size: 14px;
            color: #1e293b;
            background: #f8fafc;
            outline: none;
            transition: all .2s;
        }
        .form-group input:focus {
            border-color: #2dd4bf;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(45,212,191,.15);
        }
        .pw-hint { font-size: 11.5px; color: #94a3b8; margin-top: 5px; }
        .btn {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #2dd4bf, #0d9488);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all .25s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(13,148,136,.3);
        }
        .btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(13,148,136,.35); }
        .btn:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
        .error-msg {
            background: #fef2f2;
            color: #dc2626;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 16px;
            border: 1px solid #fecaca;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .success-msg {
            background: #f0fdf4;
            color: #166534;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 16px;
            border: 1px solid #bbf7d0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .back-link {
            text-align: center;
            margin-top: 22px;
            font-size: 13px;
            color: #64748b;
        }
        .back-link a {
            color: #0d9488;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .back-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>

    <div class="card">
        <div class="header">
            <div class="logo"><i class="fas fa-lock-open"></i></div>
            <h1>Atur Ulang Kata Sandi</h1>
            <p>Kode verifikasi berhasil divalidasi. Masukkan kata sandi baru untuk akun Anda.</p>
        </div>

        <div id="alertArea"></div>

        <div class="info-box">
            <i class="fas fa-check-circle"></i> Identitas akun Anda telah terverifikasi. Masukkan kata sandi baru yang aman.
        </div>

        <form id="formResetPassword" onsubmit="submitResetPassword(event)">
            <input type="hidden" id="resetEmail" value="@email" />
            <input type="hidden" id="resetOtp" value="@otp" />
            <input type="hidden" id="resetToken" value="@token" />

            <div class="form-group">
                <label for="newPwd">Kata Sandi Baru</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock fi"></i>
                    <input type="password" id="newPwd" placeholder="Minimal 6 karakter" required minlength="6" autocomplete="new-password" />
                    <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('newPwd', this)" title="Tampilkan kata sandi">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <div class="pw-hint">Kombinasi minimal 6 karakter</div>
            </div>

            <div class="form-group">
                <label for="confPwd">Konfirmasi Kata Sandi Baru</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock fi"></i>
                    <input type="password" id="confPwd" placeholder="Ulangi kata sandi baru" required minlength="6" autocomplete="new-password" />
                    <button type="button" class="toggle-pwd" onclick="togglePasswordVisibility('confPwd', this)" title="Tampilkan kata sandi">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" id="btnSubmit" class="btn">
                <i class="fas fa-check"></i> Simpan Kata Sandi Baru
            </button>
        </form>

        <div class="back-link">
            <a href="@loginUrl"><i class="fas fa-arrow-left"></i> Kembali ke Halaman Masuk</a>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script>
        var loginRedirectUrl = '@loginUrl';

        function togglePasswordVisibility(id, btn) {
            var $input = $('#' + id);
            var $icon = $(btn).find('i');
            if ($input.attr('type') === 'password') {
                $input.attr('type', 'text');
                $icon.attr('class', 'fas fa-eye-slash');
            } else {
                $input.attr('type', 'password');
                $icon.attr('class', 'fas fa-eye');
            }
        }

        function showError(msg) {
            $('#alertArea').html('<div class="error-msg"><i class="fas fa-exclamation-circle"></i> ' + msg + '</div>');
        }

        function showSuccess(msg) {
            $('#alertArea').html('<div class="success-msg"><i class="fas fa-check-circle"></i> ' + msg + '</div>');
        }

        function getParam(name) {
            var urlParams = new URLSearchParams(window.location.search);
            return (urlParams.get(name) || '').trim();
        }

        function submitResetPassword(e) {
            e.preventDefault();
            $('#alertArea').empty();

            var email = $('#resetEmail').val().trim() || getParam('email');
            var otp = $('#resetOtp').val().trim() || getParam('otp') || getParam('token');
            var token = $('#resetToken').val().trim() || getParam('token');
            var newPassword = $('#newPwd').val();
            var confirmPassword = $('#confPwd').val();

            if (!otp && !token) {
                showError('Kode verifikasi tidak ditemukan. Silakan ulangi langkah verifikasi kode.');
                return;
            }

            if (newPassword.length < 6) {
                showError('Kata sandi baru minimal 6 karakter.');
                return;
            }

            if (newPassword !== confirmPassword) {
                showError('Kata sandi baru dan konfirmasi kata sandi tidak cocok.');
                return;
            }

            var $btn = $('#btnSubmit');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

            $.ajax({
                url: API_BASE_URL + '/auth/reset-password',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    email: email,
                    otp: otp,
                    token: token || otp,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                }),
                success: function (res) {
                    showSuccess((res && res.message) ? res.message : 'Kata sandi Anda berhasil diperbarui. Mengalihkan ke halaman masuk...');
                    setTimeout(function () {
                        window.location.href = loginRedirectUrl;
                    }, 1400);
                },
                error: function (xhr) {
                    var msg = 'Gagal memperbarui kata sandi.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false).html('<i class="fas fa-check"></i> Simpan Kata Sandi Baru');
                }
            });
        }

        $(function () {
            var emailParam = getParam('email');
            var otpParam = getParam('otp');
            var tokenParam = getParam('token');

            if (emailParam && !$('#resetEmail').val()) {
                $('#resetEmail').val(emailParam);
            }
            if (otpParam && !$('#resetOtp').val()) {
                $('#resetOtp').val(otpParam);
            }
            if (tokenParam && !$('#resetToken').val()) {
                $('#resetToken').val(tokenParam);
            }

            if (!tokenParam && (!emailParam || !otpParam) && !$('#resetOtp').val()) {
                showError('Data verifikasi kata sandi tidak lengkap. Silakan lakukan proses verifikasi kode terlebih dahulu.');
                $('#btnSubmit').prop('disabled', true);
            }
        });
    </script>
</body>
</html>
