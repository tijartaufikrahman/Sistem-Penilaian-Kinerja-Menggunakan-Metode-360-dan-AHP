@{
    ViewData["Title"] = "Lupa Kata Sandi";
    Layout = null;
    var loginUrl = "/Account/Login";
    var verifyOtpBaseUrl = "/Account/VerifyOtp";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Lupa Kata Sandi - Sistem Informasi Penilaian Kinerja</title>
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%; max-width: 100vw; overflow-x: hidden;
            font-family: 'Plus Jakarta Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #eef7f5;
            background-image: radial-gradient(circle at 20% 30%, rgba(45,212,191,.15) 0%, transparent 50%),
                              radial-gradient(circle at 80% 70%, rgba(56,189,248,.12) 0%, transparent 50%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 10px 40px rgba(15,23,42,.08);
            padding: 44px 36px 36px;
            border: 1px solid rgba(15,23,42,.06);
        }
        @@media (max-width:480px) {
            .card { padding: 32px 20px 28px; border-radius: 16px; }
        }
        .header { text-align: center; margin-bottom: 26px; }
        .logo {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #2dd4bf, #0d9488);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            box-shadow: 0 8px 24px rgba(13,148,136,.25);
            transition: transform .3s ease;
        }
        .logo:hover { transform: scale(1.05); }
        .logo i { font-size: 28px; color: #ffffff; }
        .header h1 { font-size: 20px; color: #0f172a; font-weight: 700; margin-bottom: 6px; }
        .header p { color: #64748b; font-size: 13px; line-height: 1.6; }
        .info-box {
            background: #f0fdfa;
            border: 1px solid #ccfbf1;
            border-radius: 12px;
            padding: 13px 15px;
            font-size: 12.5px;
            color: #475569;
            line-height: 1.6;
            margin-bottom: 20px;
        }
        .info-box i { color: #0d9488; margin-right: 6px; }
        .form-group { margin-bottom: 18px; }
        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 7px;
        }
        .input-wrapper { position: relative; }
        .input-wrapper i.fi {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 15px;
        }
        .form-group input {
            width: 100%;
            padding: 12px 14px 12px 42px;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            font-size: 14px;
            color: #1e293b;
            background: #f8fafc;
            outline: none;
            transition: all .2s;
        }
        .form-group input:focus {
            border-color: #2dd4bf;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(45,212,191,.15);
        }
        .btn {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #2dd4bf, #0d9488);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all .25s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(13,148,136,.3);
        }
        .btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(13,148,136,.35); }
        .btn:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
        .error-msg {
            background: #fef2f2;
            color: #dc2626;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 16px;
            border: 1px solid #fecaca;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .success-msg {
            background: #f0fdf4;
            color: #166534;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 16px;
            border: 1px solid #bbf7d0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .step-link {
            text-align: center;
            margin-top: 16px;
            font-size: 12.5px;
        }
        .step-link a {
            color: #0d9488;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .step-link a:hover { text-decoration: underline; }
        .back-link {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: #64748b;
        }
        .back-link a {
            color: #64748b;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .back-link a:hover { color: #0f172a; text-decoration: underline; }
    </style>
</head>
<body>

    <div class="card">
        <div class="header">
            <div class="logo"><i class="fas fa-key"></i></div>
            <h1>Lupa Kata Sandi?</h1>
            <p>Masukkan alamat email Anda untuk menerima kode verifikasi pemulihan kata sandi.</p>
        </div>

        <div id="alertArea"></div>

        <div class="info-box">
            <i class="fas fa-info-circle"></i> Pastikan alamat email yang Anda masukkan aktif dan telah terdaftar.
        </div>

        <form id="formForgotPassword" onsubmit="submitForgotPassword(event)">
            <div class="form-group">
                <label for="emailInput">Alamat Email</label>
                <div class="input-wrapper">
                    <i class="fas fa-envelope fi"></i>
                    <input id="emailInput" type="email" placeholder="nama@email.com" autocomplete="email" required />
                </div>
            </div>

            <button type="submit" id="btnSubmit" class="btn">
                <i class="fas fa-paper-plane"></i> Kirim Kode Verifikasi
            </button>
        </form>

        <div class="step-link">
            <a href="@verifyOtpBaseUrl"><i class="fas fa-shield-alt"></i> Sudah memiliki kode verifikasi? Masukkan di sini</a>
        </div>

        <div class="back-link">
            <a href="@loginUrl"><i class="fas fa-arrow-left"></i> Kembali ke Halaman Masuk</a>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script>
        var verifyOtpRedirectUrl = '@verifyOtpBaseUrl';

        function showError(msg) {
            $('#alertArea').html('<div class="error-msg"><i class="fas fa-exclamation-circle"></i> ' + msg + '</div>');
        }

        function showSuccess(msg) {
            $('#alertArea').html('<div class="success-msg"><i class="fas fa-check-circle"></i> ' + msg + '</div>');
        }

        function submitForgotPassword(e) {
            e.preventDefault();
            $('#alertArea').empty();

            var email = $('#emailInput').val().trim();
            if (!email) {
                showError('Alamat email wajib diisi.');
                return;
            }

            var $btn = $('#btnSubmit');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Mengirim kode...');

            $.ajax({
                url: API_BASE_URL + '/auth/forgot-password',
                type: 'POST',
                dataType: 'json',
                contentType: 'application/json',
                data: JSON.stringify({ email: email }),
                success: function (res) {
                    showSuccess((res && res.message) ? res.message : 'Kode verifikasi telah dikirim ke alamat email Anda. Mengalihkan ke halaman verifikasi...');
                    setTimeout(function () {
                        window.location.href = verifyOtpRedirectUrl + '?email=' + encodeURIComponent(email);
                    }, 1000);
                },
                error: function (xhr) {
                    var msg = 'Gagal memproses permintaan pemulihan kata sandi.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false).html('<i class="fas fa-paper-plane"></i> Kirim Kode Verifikasi');
                }
            });
        }
    </script>
</body>
</html>
