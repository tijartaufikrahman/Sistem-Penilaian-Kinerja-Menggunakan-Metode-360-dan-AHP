@{
    ViewData["Title"] = "Verifikasi Kode";
    Layout = null;
    var loginUrl = "/Account/Login";
    var forgotUrl = "/Account/ForgotPassword";
    var resetBaseUrl = "/Account/ResetPassword";
    var email = (ViewData["Email"] as string) ?? "";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Verifikasi Kode - Sistem Informasi Penilaian Kinerja</title>
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            font-family: 'Plus Jakarta Sans', 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            background: #eef7f5;
            background-image:
                radial-gradient(circle at 20% 30%, rgba(45, 212, 191, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(56, 189, 248, 0.12) 0%, transparent 50%),
                radial-gradient(circle at 50% 100%, rgba(13, 148, 136, 0.08) 0%, transparent 40%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 1px 3px rgba(15,23,42,.04), 0 10px 40px rgba(15,23,42,.08);
            padding: 44px 36px 36px;
            border: 1px solid rgba(15,23,42,.06);
        }
        @@media (max-width:480px) {
            .card { padding: 32px 20px 28px; border-radius: 16px; }
        }
        .header { text-align: center; margin-bottom: 24px; }
        .logo {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #2dd4bf, #0d9488);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            box-shadow: 0 8px 24px rgba(13,148,136,.25);
            transition: transform .3s ease;
        }
        .logo:hover { transform: scale(1.05); }
        .logo i { font-size: 28px; color: #ffffff; }
        .header h1 { font-size: 20px; color: #0f172a; font-weight: 700; margin-bottom: 4px; }
        .header p { color: #64748b; font-size: 13px; line-height: 1.5; }
        .email-badge {
            background: #f0fdfa;
            border: 1px solid #ccfbf1;
            color: #0d9488;
            font-weight: 600;
            padding: 5px 14px;
            border-radius: 20px;
            display: inline-block;
            font-size: 13px;
            margin-top: 8px;
            word-break: break-all;
        }

        /* 6-Digit OTP Input Grid */
        .otp-container {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin: 24px 0;
        }
        .otp-digit {
            width: 48px;
            height: 56px;
            font-size: 24px;
            font-weight: 700;
            text-align: center;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            background: #f8fafc;
            color: #0f766e;
            outline: none;
            transition: all 0.2s ease;
            font-family: Consolas, 'Courier New', monospace;
        }
        @@media (max-width: 400px) {
            .otp-digit { width: 40px; height: 50px; font-size: 20px; gap: 6px; }
        }
        .otp-digit:focus {
            border-color: #2dd4bf;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.2);
        }

        .btn {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #2dd4bf, #0d9488);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all .25s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(13,148,136,.3);
        }
        .btn:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(13,148,136,.35); }
        .btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }

        .error-msg {
            background: #fef2f2;
            color: #dc2626;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 16px;
            border: 1px solid #fecaca;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .success-msg {
            background: #f0fdf4;
            color: #166534;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 13px;
            margin-bottom: 16px;
            border: 1px solid #bbf7d0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .resend-box { text-align: center; margin-top: 20px; font-size: 13px; color: #64748b; }
        .resend-link { color: #0d9488; text-decoration: none; font-weight: 600; cursor: pointer; border: none; background: none; }
        .resend-link:hover { text-decoration: underline; }
        .resend-link:disabled { color: #94a3b8; cursor: not-allowed; text-decoration: none; }
        .back-link { text-align: center; margin-top: 18px; font-size: 13px; color: #64748b; }
        .back-link a { color: #0d9488; text-decoration: none; font-weight: 500; }
        .back-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="card">
        <div class="header">
            <div class="logo"><i class="fas fa-shield-halved"></i></div>
            <h1>Verifikasi Kode Keamanan</h1>
            <p>Masukkan 6 digit kode verifikasi yang telah dikirimkan ke alamat email:</p>
            <div class="email-badge" id="displayEmail">@(string.IsNullOrEmpty(email) ? "Memuat email..." : email)</div>
        </div>

        <div id="alertArea"></div>

        <form id="formVerifyOtp" onsubmit="submitVerifyOtp(event)">
            <input type="hidden" id="hiddenEmail" value="@email" />

            <!-- 6 Kotak Digit OTP Interaktif -->
            <div class="otp-container">
                <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" autofocus />
                <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
                <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" />
            </div>

            <button type="submit" id="btnVerify" class="btn">
                <i class="fas fa-check-circle"></i> Verifikasi Kode
            </button>
        </form>

        <div class="resend-box">
            Belum menerima kode verifikasi? 
            <button type="button" class="resend-link" onclick="resendOtp()" id="btnResend">Kirim Ulang</button>
            <span id="countdownSpan" style="display:none; color:#94a3b8; font-weight:600;">(60s)</span>
        </div>

        <div class="back-link">
            <a href="@forgotUrl"><i class="fas fa-arrow-left"></i> Ganti Alamat Email</a> &bull;
            <a href="@loginUrl">Kembali ke Halaman Masuk</a>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script>
        var resendTimer = null;
        var resetPasswordBaseUrl = '@resetBaseUrl';

        function showError(msg) {
            $('#alertArea').html('<div class="error-msg"><i class="fas fa-exclamation-circle"></i> ' + msg + '</div>');
        }

        function showSuccess(msg) {
            $('#alertArea').html('<div class="success-msg"><i class="fas fa-check-circle"></i> ' + msg + '</div>');
        }

        function getTargetEmail() {
            var urlParams = new URLSearchParams(window.location.search);
            var emailParam = urlParams.get('email');
            var hiddenEmail = $('#hiddenEmail').val();
            return (emailParam || hiddenEmail || '').trim();
        }

        function getEnteredOtp() {
            var otpStr = '';
            $('.otp-digit').each(function () {
                otpStr += $(this).val().trim();
            });
            return otpStr;
        }

        function startResendCooldown() {
            var $btn = $('#btnResend');
            var $cd = $('#countdownSpan');
            $btn.prop('disabled', true);
            $cd.show();
            var countdown = 60;
            $cd.text('(' + countdown + 's)');

            if (resendTimer) clearInterval(resendTimer);
            resendTimer = setInterval(function () {
                countdown--;
                if (countdown <= 0) {
                    clearInterval(resendTimer);
                    $btn.prop('disabled', false);
                    $cd.hide();
                } else {
                    $cd.text('(' + countdown + 's)');
                }
            }, 1000);
        }

        function submitVerifyOtp(e) {
            e.preventDefault();
            $('#alertArea').empty();

            var email = getTargetEmail();
            var otp = getEnteredOtp();

            if (!email) {
                showError('Alamat email tidak valid. Silakan kembali ke halaman lupa kata sandi.');
                return;
            }

            if (otp.length < 6) {
                showError('Silakan masukkan 6 digit kode verifikasi secara lengkap.');
                return;
            }

            var $btn = $('#btnVerify');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Memverifikasi...');

            $.ajax({
                url: API_BASE_URL + '/auth/verify-otp',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({
                    email: email,
                    otp: otp
                }),
                success: function (res) {
                    showSuccess('Kode verifikasi valid. Mengalihkan ke pembuatan kata sandi baru...');
                    setTimeout(function () {
                        window.location.href = resetPasswordBaseUrl + '?email=' + encodeURIComponent(email) + '&otp=' + encodeURIComponent(otp);
                    }, 800);
                },
                error: function (xhr) {
                    var msg = 'Kode verifikasi tidak sesuai atau telah kedaluwarsa.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false).html('<i class="fas fa-check-circle"></i> Verifikasi Kode');
                }
            });
        }

        function resendOtp() {
            var email = getTargetEmail();
            if (!email) {
                showError('Alamat email tidak ditemukan.');
                return;
            }

            var $btn = $('#btnResend');
            $btn.prop('disabled', true);

            $.ajax({
                url: API_BASE_URL + '/auth/resend-otp',
                type: 'POST',
                contentType: 'application/json',
                dataType: 'json',
                data: JSON.stringify({ email: email }),
                success: function (res) {
                    showSuccess((res && res.message) ? res.message : 'Kode verifikasi baru telah dikirim ke alamat email Anda.');
                    $('.otp-digit').val('');
                    $('.otp-digit').first().focus();
                    startResendCooldown();
                },
                error: function (xhr) {
                    var msg = 'Gagal mengirim ulang kode verifikasi.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    showError(msg);
                    $btn.prop('disabled', false);
                }
            });
        }

        $(function () {
            var email = getTargetEmail();
            if (email) {
                $('#displayEmail').text(email);
                $('#hiddenEmail').val(email);
            } else {
                $('#displayEmail').text('Email tidak terdeteksi');
            }

            var $digits = $('.otp-digit');

            $digits.on('input', function () {
                var val = $(this).val().replace(/[^0-9]/g, '');
                $(this).val(val);

                if (val.length >= 1) {
                    var $next = $(this).next('.otp-digit');
                    if ($next.length) {
                        $next.focus();
                    }
                }
            });

            $digits.on('keydown', function (e) {
                if (e.key === 'Backspace' && !$(this).val()) {
                    var $prev = $(this).prev('.otp-digit');
                    if ($prev.length) {
                        $prev.focus();
                    }
                }
            });

            $digits.first().on('paste', function (e) {
                var pasted = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
                if (pasted && /^\d{6}$/.test(pasted.trim())) {
                    e.preventDefault();
                    var digitsArr = pasted.trim().split('');
                    $digits.each(function (i) {
                        $(this).val(digitsArr[i] || '');
                    });
                    $digits.last().focus();
                }
            });
        });
    </script>
</body>
</html>
