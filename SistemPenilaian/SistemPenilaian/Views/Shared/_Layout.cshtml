<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#0a101d" />
    <title>@ViewData["Title"] - Sistem Informasi Penilaian Kinerja</title>

    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- DataTables 1.13.7 Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <!-- Admin Custom CSS (100% Identik dengan Project 7 FE_Startup) -->
    <link rel="stylesheet" href="~/css/admin.css?v=@DateTime.UtcNow.Ticks" asp-append-version="true" />
</head>
<body>
    <!-- ATURAN 1: Tepat sesudah <body> WAJIB langsung dibungkus container-fluid overflow-hidden -->
    <div class="container-fluid overflow-hidden px-0 position-relative min-vh-100">
        
        <!-- Sidebar Identik Project 7 -->
        <nav class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="/Admin/Dashboard" id="sidebarBrandLink" class="sidebar-brand">
                    <div class="brand-icon-box" id="sidebarBrandIconBox">
                        <i class="fas fa-award" id="sidebarBrandIcon"></i>
                    </div>
                    <div class="brand-text-block" style="min-width:0; max-width:185px;">
                        <h3 class="brand-name" id="sidebarBrandName" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin:0;" title="Sistem Penilaian">Sistem Penilaian</h3>
                        <span style="font-size:0.7rem; color:#94a3b8; font-weight:600; display:block;">Evaluasi &amp; Capaian Kinerja</span>
                    </div>
                </a>
            </div>

            <div class="sidebar-nav-container" id="sidebarNav">
                <div id="dynamicSidebarMenus">
                    <div style="padding:16px 20px; color:#64748b; font-size:12px;">
                        <i class="fas fa-spinner fa-spin me-2"></i> Memuat navigasi...
                    </div>
                </div>
            </div>

            <div class="sidebar-bottom">
                <button type="button" id="btnLogout" class="btn-sidebar-exit-wide" title="Keluar dari Sistem" onclick="handlePlatformLogout()">
                    <i class="fas fa-arrow-right-from-bracket"></i>
                    <span>Keluar</span>
                </button>
            </div>
        </nav>

        <!-- Topbar Identik Project 7 -->
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="btn-menu-toggle" id="menuToggle" aria-label="Toggle Sidebar" onclick="toggleSidebar()">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="topbar-page-label">
                    <h2 class="topbar-page-title" id="pageTitleText">@ViewData["Title"]</h2>
                </div>
            </div>

            <div class="topbar-right">
                <div class="topbar-user-card" onclick="showProfileModal()" title="Lihat Profil Pengguna">
                    <div class="topbar-user-avatar" id="headerUserAvatar">U</div>
                    <div class="topbar-user-meta">
                        <div class="topbar-user-name" id="headerUserName">Pengguna</div>
                        <div class="topbar-user-role">
                            <span class="role-status-dot"></span>
                            <span id="headerUserRole">HRD</span>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content Area -->
        <div class="main-content" id="mainContent">
            @RenderBody()
        </div>

        <!-- Mobile Overlay Backdrop -->
        <div class="sidebar-overlay-backdrop" id="sidebarOverlay" onclick="toggleSidebar(false)"></div>
    </div>

    <!-- Core Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables 1.13.7 Core & Bootstrap 5 Integration -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- App JS -->
    <script src="~/js/api-config.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
    <script src="~/js/admin.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>

    <script>
        // Standar DataTables Bahasa Indonesia & Arrow Pagination (100% Sesuai aturan_penulisankode_datatable.txt)
        window.dtLanguageConfig = {
            lengthMenu: "Tampilkan _MENU_ data per halaman",
            zeroRecords: "Data tidak ditemukan",
            info: "Menampilkan _START_ sampai _END_ dari _TOTAL_ total data",
            infoEmpty: "Menampilkan 0 sampai 0 dari 0 data",
            infoFiltered: "(difilter dari _MAX_ total data)",
            search: "Cari:",
            searchPlaceholder: "Ketik kata kunci...",
            paginate: {
                first: "«",
                last: "»",
                next: "›",
                previous: "‹"
            },
            processing: "Sedang memproses data...",
            loadingRecords: "Memuat data..."
        };

        window.dtLengthMenuConfig = [
            [10, 25, 50, 100, -1],
            [10, 25, 50, 100, "Semua"]
        ];

        // Global DataTables Default Configuration
        if (window.jQuery && $.fn && $.fn.dataTable) {
            $.extend(true, $.fn.dataTable.defaults, {
                pageLength: 10,
                lengthMenu: window.dtLengthMenuConfig,
                language: window.dtLanguageConfig
            });
        }

        // Global Logout Handler
        window.handlePlatformLogout = function () {
            Swal.fire({
                title: 'Konfirmasi Keluar',
                text: 'Apakah Anda yakin ingin keluar dari sistem penilaian kinerja?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d9488',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Keluar',
                cancelButtonText: 'Batal'
            }).then(function (result) {
                if (result.isConfirmed) {
                    if (window.AuthSession && typeof window.AuthSession.removeUser === 'function') {
                        window.AuthSession.removeUser();
                    } else {
                        localStorage.clear();
                        sessionStorage.clear();
                    }
                    window.location.href = '/Account/Login';
                }
            });
        };

        // Info Profil Singkat
        function showProfileModal() {
            var currentUser = window.AuthSession ? window.AuthSession.getUser() : null;
            if (!currentUser) return;

            var roleText = (currentUser.roleId === 1 || currentUser.roleName === 'HRD') 
                ? 'Pengelola Penilaian (HRD)' 
                : 'Karyawan';

            Swal.fire({
                title: '<strong>Profil Pengguna</strong>',
                icon: 'info',
                html: '<div class="text-start p-2" style="font-size:13.5px;">' +
                      '<p class="mb-1"><strong>Nama Lengkap:</strong> ' + escHtml(currentUser.namaLengkap || '-') + '</p>' +
                      '<p class="mb-1"><strong>Alamat Email:</strong> ' + escHtml(currentUser.email || '-') + '</p>' +
                      '<p class="mb-1"><strong>Kode Karyawan:</strong> <span class="badge bg-light text-dark border">' + escHtml(currentUser.kodeKaryawan || '-') + '</span></p>' +
                      '<p class="mb-1"><strong>Peran Akses:</strong> <span class="status-pill pill-role">' + escHtml(roleText) + '</span></p>' +
                      '</div>',
                confirmButtonColor: '#0d9488',
                confirmButtonText: 'Tutup'
            });
        }

        // Helper Breadcrumb Dinamis (Project 7 Style)
        function updatePageBreadcrumb(parent, current) {
            var $bc = $('#pageBreadcrumb');
            if (!$bc.length) return;
            
            // Jangan tampilkan breadcrumb jika di Dashboard / Beranda
            var curPath = window.location.pathname.toLowerCase().replace(/\/+$/, '');
            if (curPath === '/admin/dashboard' || curPath === '/admin' || curPath === '/karyawan/dashboard' || curPath === '/karyawan/beranda' || curPath === '/karyawan') {
                $bc.closest('.content-breadcrumb-bar').hide();
                $bc.empty();
                return;
            }

            if (!current) {
                // Tampilan satu tingkat: "Kelola Karyawan /"
                $bc.html('<span class="breadcrumb-current">' + escHtml(parent) + '</span> <span class="breadcrumb-separator">/</span>');
            } else {
                // Tampilan dua tingkat jika masuk ke sub/detail: "Parent / Child"
                $bc.html('<span class="breadcrumb-parent">' + escHtml(parent) + '</span> <span class="breadcrumb-separator">/</span> <span class="breadcrumb-current">' + escHtml(current) + '</span>');
            }
        }

        // Render Navigasi Menu Dinamis
        function renderSidebarNavigation(items, currentUser) {
            var curPathClean = window.location.pathname.toLowerCase().replace(/\/+$/, '');
            var html = '';

            if (items && items.length > 0) {
                // Urutkan berdasarkan urutan
                items.sort(function (a, b) {
                    return (a.urutan || 0) - (b.urutan || 0);
                });

                var activeMenuFound = null;

                for (var i = 0; i < items.length; i++) {
                    var m = items[i];
                    var mUrl = (m.url || '#').toLowerCase().replace(/\/+$/, '');
                    var isActive = (curPathClean === mUrl || (mUrl !== '' && mUrl !== '/' && curPathClean.startsWith(mUrl)));

                    // Jika berada di halaman TambahPeriode atau HasilPenilaian, kaitkan dengan menu yang sesuai
                    if (curPathClean === '/admin/tambahperiode' && mUrl === '/admin/periode') {
                        isActive = true;
                    } else if (curPathClean === '/admin/hasilpenilaian') {
                        var ref = (document.referrer || '').toLowerCase();
                        if (ref.indexOf('riwayatpenilaian') !== -1 && mUrl === '/admin/riwayatpenilaian') {
                            isActive = true;
                        } else if (ref.indexOf('riwayatpenilaian') === -1 && mUrl === '/admin/periode') {
                            isActive = true;
                        }
                    } else if (curPathClean === '/karyawan/evaluasi360' && mUrl === '/karyawan/penilaiankinerja') {
                        isActive = true;
                    } else if (curPathClean === '/karyawan/raporkinerja' && mUrl === '/karyawan/kinerjapribadi') {
                        isActive = true;
                    } else if (curPathClean === '/karyawan/riwayatevaluasi' && mUrl === '/karyawan/historypenilaian') {
                        isActive = true;
                    } else if ((curPathClean === '/karyawan/beranda' || curPathClean === '/karyawan/dashboard') && (mUrl === '/karyawan/beranda' || mUrl === '/karyawan/dashboard')) {
                        isActive = true;
                    }

                    if (isActive && !activeMenuFound) {
                        activeMenuFound = m;
                    }

                    var iconClass = m.icon || 'fas fa-circle-dot';

                    html += '<a class="sidebar-link ' + (isActive ? 'active' : '') + '" href="' + (m.url || '#') + '">' +
                            '<i class="' + iconClass + ' link-icon"></i>' +
                            '<span>' + escHtml(m.namaMenu) + '</span>' +
                            '</a>';
                }

                if (activeMenuFound) {
                    var lowerMenu = activeMenuFound.namaMenu.toLowerCase();
                    if (lowerMenu.indexOf('dashboard') !== -1 || lowerMenu.indexOf('beranda') !== -1) {
                        $('#pageBreadcrumb').closest('.content-breadcrumb-bar').hide();
                        $('#pageBreadcrumb').empty();
                    } else if (curPathClean !== '/admin/hasilpenilaian' && curPathClean !== '/admin/tambahperiode') {
                        // Sesuai permintaan: breadcrumb menampilkan menu sidebar: "Kelola Karyawan /"
                        updatePageBreadcrumb(activeMenuFound.namaMenu);
                    }
                }
            } else {
                html = '<div style="padding:16px 20px; color:#64748b; font-size:12px;">Tidak ada menu yang ditautkan</div>';
            }

            $('#dynamicSidebarMenus').html(html);
        }

        function loadSidebarMenus(currentUser) {
            var roleId = currentUser.roleId || 1;
            var cacheKey = 'spk_menus_role_' + roleId;
            var cached = sessionStorage.getItem(cacheKey);

            if (cached) {
                try {
                    renderSidebarNavigation(JSON.parse(cached), currentUser);
                } catch(e) {}
            }

            $.ajax({
                url: API_BASE_URL + '/admin/menuroles/role/' + roleId,
                type: 'GET',
                dataType: 'json',
                success: function (menus) {
                    if (menus && menus.length > 0) {
                        sessionStorage.setItem(cacheKey, JSON.stringify(menus));
                        renderSidebarNavigation(menus, currentUser);
                    }
                }
            });
        }

        $(function () {
            if (!window.AuthSession || !window.AuthSession.isAuthenticated()) {
                window.location.href = '/Account/Login';
                return;
            }

            var currentUser = window.AuthSession.getUser();
            if (!currentUser) {
                window.location.href = '/Account/Login';
                return;
            }

            var name = currentUser.namaLengkap || currentUser.email || 'Pengguna';
            var role = currentUser.roleName || (currentUser.roleId === 1 ? 'HRD' : 'Karyawan');
            var initial = (name.trim().charAt(0) || 'U').toUpperCase();

            $('#headerUserName').text(name).attr('title', name);
            $('#headerUserRole').text(role);
            $('#headerUserAvatar').text(initial);

            if (currentUser.roleId === 2) {
                $('#sidebarBrandLink').attr('href', '/Karyawan/Dashboard');
            } else {
                $('#sidebarBrandLink').attr('href', '/Admin/Dashboard');
            }

            loadSidebarMenus(currentUser);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
